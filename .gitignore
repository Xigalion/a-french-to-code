node_modules/
.cache/
extension/out/
/debug.log

# Binaires produits par la recette GCC de l'exercice
exercice/**/*.exe
exercice/**/*.o

# Paquet .vsix et dossier de travail de la compilation du test utilisateur
dist/
# Dossiers de travail des compilations : le C de reference est ailleurs
test-utilisateur/journal/build/
exercice/promotion/journal/build/
exercice/promotion/journal-complements/build/

# Fichiers ECRITS par les programmes de l'exercice Python : ils sont une
# sortie, pas une source, et le script les reecrit a chaque execution.
exercice/python/journal/*.txt

# Notes locales non publiees (table de correspondance des identifiants reecrits)
local/

# Instructions de travail internes : conservees localement, jamais publiees
/CLAUDE.md

# Artefacts compiles de Python : produits a l execution des exercices,
# jamais lus par un test, et sans valeur dans un depot public.
__pycache__/
*.pyc
